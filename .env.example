# Copy to .env. Never commit the real .env file.
#
# Every value has a working default, so Lapus runs with no .env at all. Set
# these only when the defaults are wrong for your machine.

# The staging database the parser produced. A bare path means SQLite; a
# postgresql:// URL selects PostgreSQL. Defaults to Spec_Stage.db in the
# working directory, then Desktop/Specs/Spec_Stage.db.
LAPUS_DATABASE_URL=Spec_Stage.db

# Where Lapus writes change requests. Defaults to a per-user application data
# folder, deliberately not beside the staging file. Never set this to the
# staging database.
# LAPUS_APP_DATABASE_URL=/path/to/lapus.db

# Stand-in identity until real authentication is wired in.
DEV_USER_EMAIL=developer@example.com
LAPUS_DEV_USER_IS_APPROVER=true

# Separation of duties. True lets one person approve their own submission,
# which the single-user POC needs in order to demonstrate approvals at all.
# Set to false once Lapus has more than one real user.
LAPUS_ALLOW_SELF_APPROVAL=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8770
FRONTEND_ORIGIN=http://localhost:5173
